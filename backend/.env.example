# Server Configuration
# Note: Port 5050 is recommended on Windows to avoid reserved ports (5000-5001 reserved by Hyper-V/WinNAT)
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillnex?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
ADMIN_SETUP_SECRET=your_secure_admin_setup_secret_here

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
